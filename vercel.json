{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "IBM_WATSONX_URL": "https://us-south.ml.cloud.ibm.com",
    "IBM_MODEL_ID": "ibm/granite-3-1-8b-base",
    "FLASK_DEBUG": "false"
  }
}
