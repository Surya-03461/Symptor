{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/style.css",
      "dest": "/static/style.css",
      "headers": { "Cache-Control": "public, max-age=31536000" }
    },
    {
      "src": "/static/app.js",
      "dest": "/static/app.js",
      "headers": { "Cache-Control": "public, max-age=31536000" }
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
